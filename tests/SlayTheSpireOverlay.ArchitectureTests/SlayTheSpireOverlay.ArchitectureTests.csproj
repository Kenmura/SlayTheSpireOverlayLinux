<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="GodotSharp" Version="4.7.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SlayTheSpireOverlay.Godot\SlayTheSpireOverlay.Godot.csproj" />
    <ProjectReference Include="..\..\src\SlayTheSpireMapFog.Godot\SlayTheSpireMapFog.Godot.csproj" />
    <ProjectReference Include="..\..\src\SlayTheSpireTestSubjectVote.Godot\SlayTheSpireTestSubjectVote.Godot.csproj" />
  </ItemGroup>

  <!-- Mod types that implement game interfaces (INetMessage) only load when sts2.dll sits beside the tests.
       The copy goes to bin/ (git-ignored), never into the repo. -->
  <ItemGroup Condition="Exists('$(Sts2DataDir)/sts2.dll')">
    <None Include="$(Sts2DataDir)/sts2.dll" Link="sts2.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
