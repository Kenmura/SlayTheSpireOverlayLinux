<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Compile Include="..\SlayTheSpireMapFog.Core\**\*.cs" Exclude="..\SlayTheSpireMapFog.Core\obj\**;..\SlayTheSpireMapFog.Core\bin\**" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.7.2" ExcludeAssets="Runtime" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <UsesSts2>true</UsesSts2>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="SlayTheSpireMapFog.Godot.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
