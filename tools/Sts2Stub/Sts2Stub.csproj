<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>sts2</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Stubs mirror the game's API shapes, so design rules and unused-member warnings (static-able members, public fields, events never raised) do not apply. -->
    <NoWarn>$(NoWarn);CA1711;CA1051;CA1822;CS0067;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.7.2" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>

  <Target Name="CopyHarmonyDll" AfterTargets="Build">
    <ItemGroup>
      <HarmonyFiles Include="$(TargetDir)0Harmony.dll" />
    </ItemGroup>
  </Target>

</Project>
